<Window x:Class="Quickey.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quickey Settings" Width="520" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Icon="/Assets/quickey.ico"
        Background="#FAFAFC" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6880" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Width" Value="110" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="#6366F1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,8,24,20">
        <TextBlock Style="{StaticResource Section}" Text="How it works" />
        <TextBlock Style="{StaticResource Hint}">
            Start dragging files in File Explorer, then tap a key to open a wheel. Drop onto an option to run it.
            Your files never leave this PC. You can also right-click files and choose “Convert with Quickey”.
        </TextBlock>

        <TextBlock Style="{StaticResource Section}" Text="Keys" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>
            <TextBlock Text="Convert wheel" VerticalAlignment="Center" />
            <ComboBox x:Name="ConvertKey" Grid.Column="1" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="Tools wheel" VerticalAlignment="Center" />
            <ComboBox x:Name="ToolsKey" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="Actions wheel" VerticalAlignment="Center" />
            <ComboBox x:Name="ActionsKey" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" />
        </Grid>
        <TextBlock x:Name="KeyError" Foreground="#C2410C" Visibility="Collapsed" Text="Each wheel needs a different key." />

        <TextBlock Style="{StaticResource Section}" Text="Behaviour" />
        <CheckBox x:Name="ExplorerOnly" Content="Only open the wheel for drags from File Explorer and the desktop" />
        <CheckBox x:Name="Subfolder" Content="Save results in a “Quickey” subfolder instead of next to the original" />
        <CheckBox x:Name="Notifications" Content="Show a notification when a conversion finishes" />
        <CheckBox x:Name="StartWithWindows" Content="Start Quickey when I sign in" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Excel workbooks with several sheets" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="ExcelSheets" Width="170" />
        </StackPanel>
        <CheckBox x:Name="ContextMenuOption" Content="Add “Convert with Quickey” to the right-click menu" />

        <TextBlock Style="{StaticResource Section}" Text="License" />
        <TextBlock x:Name="LicenseStatus" TextWrapping="Wrap" />
        <Grid x:Name="ActivatePanel" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LicenseKey" Padding="4" VerticalContentAlignment="Center" />
            <Button x:Name="ActivateButton" Grid.Column="1" Style="{StaticResource Primary}" Margin="8,0,0,0" Content="Activate" Click="OnActivate" />
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="GetPro" Style="{StaticResource Primary}" Content="Get Quickey Pro" Click="OnGetPro" Margin="0,0,8,0" />
            <Button x:Name="Deactivate" Content="Deactivate on this PC" Padding="12,6" Click="OnDeactivate" />
        </StackPanel>

        <DockPanel Margin="0,24,0,0" LastChildFill="False">
            <TextBlock x:Name="Version" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#6B6880" />
            <Button DockPanel.Dock="Right" Content="Close" Padding="18,6" IsCancel="True" Click="OnClose" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Save" IsDefault="True" Margin="0,0,8,0" Click="OnSave" />
        </DockPanel>
    </StackPanel>
</Window>
